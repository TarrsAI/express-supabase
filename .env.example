# Auto-injected by Tarrs into the dev sandbox. For local dev, paste from
# your Supabase project's Settings → API.
SUPABASE_URL=

# Service-role key — bypasses RLS. Used by `db/supabase.ts:supabaseAdmin`
# for server-owned operations (system jobs, materialized refreshes,
# admin endpoints). NEVER ship to a browser. The 4xx/5xx envelope
# will protect against accidental error-message echoes, but the key
# itself must stay server-side.
SUPABASE_SERVICE_ROLE_KEY=

# Anon (public) key — used by `db/supabase.ts:supabaseAs(req)` to
# build a per-request user-scoped client that triggers RLS. Without
# this, RLS-scoped queries are impossible and the service layer
# silently falls back to admin (which DEFEATS RLS). Set this.
SUPABASE_ANON_KEY=

# JWT verification secret. We verify the Bearer token on every request
# using this. Find at Supabase project: Settings → API → JWT Settings.
SUPABASE_JWT_SECRET=

# CORS — comma-separated origins (e.g. https://yourapp.com). Empty
# disables cross-origin requests entirely. Never set to "*" with
# credentials.
CORS_ORIGINS=

# CSRF allowed origins. Only relevant if you opt INTO the requireCsrf
# middleware (see middleware/csrf.ts) — Bearer-auth APIs don't need
# it. If you do enable it and leave this unset, the middleware reuses
# CORS_ORIGINS.
CSRF_ALLOWED_ORIGINS=

# Trust proxy hop count. 1 = behind one ALB / Caddy (Tarrs default);
# 2 = behind CloudFront + ALB; etc. Required for correct req.ip +
# X-Forwarded-For handling.
TRUST_PROXY=1

PORT=4000
LOG_LEVEL=info
NODE_ENV=development
