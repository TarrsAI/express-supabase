# Auto-injected by Tarrs into the dev sandbox. For local dev, paste from
# your Supabase project's Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used to verify JWTs that frontends pass in Authorization: Bearer ...
# Find this in Supabase project: Settings → API → JWT Settings → secret
SUPABASE_JWT_SECRET=

# CORS — comma-separated origins (e.g. https://yourapp.com). Empty
# disables cross-origin requests entirely. Never set to "*" with
# credentials.
CORS_ORIGINS=

PORT=4000
LOG_LEVEL=info
